# Python (Vercel Environment Variables + local .env)
EDGAR_IDENTITY="Your Name your-email@example.com"
# Default when the UI does not send a model (server fallback).
# NOTE: this env var OVERRIDES the built-in default in server/llm_service.py.
# If it is set to an old value, you stay on that model no matter what the code says.
LITELLM_MODEL="openai/gpt-5.4-mini"
# Optional - only needed to select the Anthropic models in the picker.
# ANTHROPIC_API_KEY=""
# Required: the default chat model and the courseware retrieval embeddings
# (text-embedding-3-small) both run on OpenAI.
OPENAI_API_KEY=""
# Optional — needed when selecting Google models in the app (LiteLLM)
# GEMINI_API_KEY=""

# Optional: override API origin (default: same-origin, e.g. empty on Vercel)
# NEXT_PUBLIC_API_BASE_URL=

# Chat: server default system prompt (optional). UI override requires COPILOT_ALLOW_CLIENT_SYSTEM_PROMPT=1.
# COPILOT_SYSTEM_PROMPT="You are SEC Copilot..."
# COPILOT_ALLOW_CLIENT_SYSTEM_PROMPT=1

# Chat: optional bounds for per-request slider limits (defaults shown in llm_service.py)
# COPILOT_CURRENT_CONTEXT_CHARS_MIN=2000
# COPILOT_CURRENT_CONTEXT_CHARS_MAX=120000
# COPILOT_ADDITIONAL_CONTEXT_CHARS_MIN=0
# COPILOT_ADDITIONAL_CONTEXT_CHARS_MAX=80000

# Courseware retrieval (see courseware/README.md). Defaults shown.
# COURSEWARE_ENABLED=1
# COURSEWARE_TOP_K=6
# COURSEWARE_MIN_SCORE=0.45
# COURSEWARE_MAX_PER_SECTION=2
# Server default / bounds for the "Course material" slider (chars).
# COPILOT_COURSEWARE_CONTEXT_CHARS=12000
# COPILOT_COURSEWARE_CONTEXT_CHARS_MIN=0
# COPILOT_COURSEWARE_CONTEXT_CHARS_MAX=24000

# Agent mode: tool-using loop instead of one-shot prompt stuffing. ON by
# default. Needs a model with tool-calling support; any failure (no tool
# support, provider error, bad loop) falls back to single-shot automatically.
# Set to 0 to force the single-shot path, e.g. to A/B the two.
# COPILOT_AGENT_MODE=0
# COPILOT_AGENT_MAX_TURNS=5          # last turn answers with tools withheld
# COPILOT_AGENT_TIME_BUDGET_S=40     # keep under the 60s vercel.json maxDuration

# Usage logging: one `chat_usage` line per question in the function logs, with
# tokens, cache hits, and cost. Set to DEBUG for litellm's own chatter too.
# COPILOT_LOG_LEVEL=INFO
